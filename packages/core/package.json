{
  "name": "@loctt/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./board/columns.js": {
      "types": "./dist/board/columns.d.ts",
      "import": "./dist/board/columns.js"
    },
    "./users/pins.js": {
      "types": "./dist/users/pins.d.ts",
      "import": "./dist/users/pins.js"
    },
    "./users/sidebarGroups.js": {
      "types": "./dist/users/sidebarGroups.d.ts",
      "import": "./dist/users/sidebarGroups.js"
    },
    "./config/color.js": {
      "types": "./dist/config/color.d.ts",
      "import": "./dist/config/color.js"
    },
    "./query/filters.js": {
      "types": "./dist/query/filters.d.ts",
      "import": "./dist/query/filters.js"
    },
    "./query/parser.js": {
      "types": "./dist/query/parser.d.ts",
      "import": "./dist/query/parser.js"
    },
    "./query/serialize.js": {
      "types": "./dist/query/serialize.d.ts",
      "import": "./dist/query/serialize.js"
    },
    "./query/tokenizer.js": {
      "types": "./dist/query/tokenizer.d.ts",
      "import": "./dist/query/tokenizer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loctt/contracts": "*",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.3",
    "ulid": "^3.0.2",
    "yaml": "^2.8.3"
