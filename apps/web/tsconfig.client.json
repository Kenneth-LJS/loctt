{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/client",
    "rootDir": "src/client",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true
  },
  "include": ["src/client"]
}
