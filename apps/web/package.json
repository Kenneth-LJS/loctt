{
  "name": "@loctt/web",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "bin": {
    "loctt-ui": "dist/server/cli.js"
  },
  "files": [
    "dist/server/index.js",
    "dist/server/index.d.ts",
    "dist/server/cli.js",
    "dist/client"
  ],
  "scripts": {
    "build": "vite build && tsc -b tsconfig.server.json && tsup",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:host": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client -- --host\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@loctt/contracts": "*",
    "@loctt/core": "*",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-cell": "^3.30.1",
    "@tiptap/extension-table-header": "^3.30.1",
    "@tiptap/extension-table-row": "^3.30.1",
    "@tiptap/extensions": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "busboy": "^1.6.0",
    "codemirror": "^6.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "vite": "^6.0.0",
    "tsup": "^8.5.1"
  },
  "license": "MIT"
}
