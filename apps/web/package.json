{
  "name": "@loctt/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@loctt/contracts": "*",
    "@loctt/core": "*",
    "busboy": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "vite": "^6.0.0"
  }
}
