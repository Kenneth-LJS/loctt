{
  "name": "@loctt/cli",
  "version": "0.1.0",
  "description": "Local-first task tracking that lives in your repo. Markdown-based, fully configurable, built for devs and AI agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kenneth-LJS/loctt",
    "directory": "apps/cli"
  },
  "main": "dist/index.js",
  "bin": {
    "loctt": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "cd ../.. && npm run build",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "busboy": "^1.6.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.4",
    "ulid": "^3.0.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=20"
  }
}
