{
  "name": "@loctt/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Internal workspace: the LocTT MCP server, published inside the `loctt` package as `loctt mcp`.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kenneth-LJS/loctt",
    "directory": "apps/mcp"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.4",
    "ulid": "^3.0.2",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=20"
  }
}
